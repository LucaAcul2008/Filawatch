# Filawatch Backend Konfiguration (optional)
# Alle Einstellungen können auch über die Web-UI gemacht werden.

# JWT Secret - in Production UNBEDINGT ÄNDERN!
JWT_SECRET=filawatch-change-this-in-production

# Initiales Admin-Passwort (nur beim allerersten Start relevant)
INITIAL_ADMIN_PASSWORD=admin1234

# VAPID Subject für Push-Notifications
VAPID_SUBJECT=mailto:filawatch@example.com

# Server Port
PORT=3001
